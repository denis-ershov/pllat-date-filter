#: pllat-date-filter.php
msgid "Date Filter Settings"
msgstr "Настройки фильтра дат"

#: pllat-date-filter.php
msgid "Date Filter"
msgstr "Фильтр дат"

#: pllat-date-filter.php
msgid "PLLAT Date Filter"
msgstr "PLLAT Фильтр дат"

#: pllat-date-filter.php
msgid "PLLAT Date Filter - Settings"
msgstr "PLLAT Фильтр дат — Настройки"

#: pllat-date-filter.php
msgid "Configure date filtering for posts processed by Polylang Automatic AI Translation plugin."
msgstr "Настройте фильтрацию по дате для записей, обрабатываемых плагином Polylang Automatic AI Translation."

#: pllat-date-filter.php
msgid "Enable Filtering"
msgstr "Включить фильтрацию"

#: pllat-date-filter.php
msgid "Enable date filtering for posts"
msgstr "Включить фильтрацию записей по дате"

#: pllat-date-filter.php
msgid "Filter Type"
msgstr "Тип фильтра"

#: pllat-date-filter.php
msgid "From specific date"
msgstr "С определённой даты"

#: pllat-date-filter.php
msgid "Date range"
msgstr "Диапазон дат"

#: pllat-date-filter.php
msgid "Choose filter type: from specific date or within date range"
msgstr "Выберите тип фильтра: с определённой даты или в диапазоне дат"

#: pllat-date-filter.php
msgid "Start Date"
msgstr "Начальная дата"

#: pllat-date-filter.php
msgid "Start date for filtering (inclusive)"
msgstr "Начальная дата для фильтрации (включительно)"

#: pllat-date-filter.php
msgid "End Date"
msgstr "Конечная дата"

#: pllat-date-filter.php
msgid "End date for filtering (inclusive). Used only with \"Date range\" option"
msgstr "Конечная дата для фильтрации (включительно). Используется только с опцией «Диапазон дат»"

#: pllat-date-filter.php
msgid "Date Order"
msgstr "Порядок по дате"

#: pllat-date-filter.php
msgid "Ascending (oldest first)"
msgstr "По возрастанию (сначала старые)"

#: pllat-date-filter.php
msgid "Descending (newest first)"
msgstr "По убыванию (сначала новые)"

#: pllat-date-filter.php
msgid "Order of posts by publication date"
msgstr "Порядок записей по дате публикации"

#: pllat-date-filter.php
msgid "Post Status"
msgstr "Статус записей"

#: pllat-date-filter.php
msgid "Published"
msgstr "Опубликовано"

#: pllat-date-filter.php
msgid "Draft"
msgstr "Черновик"

#: pllat-date-filter.php
msgid "Pending Review"
msgstr "Ожидает проверки"

#: pllat-date-filter.php
msgid "Private"
msgstr "Личная"

#: pllat-date-filter.php
msgid "Scheduled"
msgstr "Запланирована"

#: pllat-date-filter.php
msgid "Trash"
msgstr "Корзина"

#: pllat-date-filter.php
msgid "Select which post statuses to include in filtering. At least one status must be selected."
msgstr "Выберите статусы записей для фильтрации. Должен быть выбран хотя бы один статус."

#: pllat-date-filter.php
msgid "Settings saved"
msgstr "Настройки сохранены"

#: pllat-date-filter.php
msgid "Filter Settings"
msgstr "Настройки фильтра"

#: pllat-date-filter.php
msgid "Save Settings"
msgstr "Сохранить настройки"

#: pllat-date-filter.php
msgid "Information"
msgstr "Информация"

#: pllat-date-filter.php
msgid "How it works:"
msgstr "Как это работает:"

#: pllat-date-filter.php
msgid "Plugin filters posts when Polylang Automatic AI Translation runs"
msgstr "Плагин фильтрует записи при запуске Polylang Automatic AI Translation"

#: pllat-date-filter.php
msgid "\"From specific date\" - processes posts published on or after specified date"
msgstr "«С определённой даты» — обрабатывает записи, опубликованные в указанную дату или позже"

#: pllat-date-filter.php
msgid "\"Date range\" - processes posts published between two specific dates"
msgstr "«Диапазон дат» — обрабатывает записи, опубликованные между двумя указанными датами"

#: pllat-date-filter.php
msgid "Date order controls the sequence of post processing"
msgstr "Порядок по дате определяет последовательность обработки записей"

#: pllat-date-filter.php
msgid "Post status filter allows targeting specific post types by their publication status"
msgstr "Фильтр статуса позволяет выбирать записи по статусу публикации"

#: pllat-date-filter.php
msgid "Filtering is applied automatically when enabled"
msgstr "Фильтрация применяется автоматически при включении"

#: pllat-date-filter.php
msgid "Current settings:"
msgstr "Текущие настройки:"

#: pllat-date-filter.php
msgid "Status:"
msgstr "Статус:"

#: pllat-date-filter.php
msgid "Enabled"
msgstr "Включено"

#: pllat-date-filter.php
msgid "Disabled"
msgstr "Отключено"

