msgid "To check if filter is working, look at WordPress error log. When filter is applied, you will see entries like:"
msgstr "Чтобы проверить работу фильтра, смотрите лог ошибок WordPress. При применении фильтра появятся записи вида:"

#: pllat-date-filter.php
msgid "Settings location:"
msgstr "Расположение настроек:"

#: pllat-date-filter.php
msgid "Settings are located in %s menu"
msgstr "Настройки находятся в меню %s"

#: pllat-date-filter.php
msgid "Languages → Date Filter"
msgstr "Языки → Фильтр дат"

#: pllat-date-filter.php
msgid "Settings → PLLAT Date Filter"
msgstr "Настройки → PLLAT Фильтр дат"

#: pllat-date-filter.php
msgid "Note: After activating Polylang, settings will move to \"Languages\" menu"
msgstr "Примечание: После активации Polylang настройки переместятся в меню «Языки»"

#: pllat-date-filter.php
msgid "Log location:"
msgstr "Путь к логу:"

