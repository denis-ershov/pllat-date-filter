msgid "Settings"
msgstr "Настройки"

#: pllat-date-filter.php
msgid "Warning:"
msgstr "Предупреждение:"

#: pllat-date-filter.php
msgid "Polylang plugin not detected. This plugin is designed to work with Polylang Automatic AI Translation."
msgstr "Плагин Polylang не обнаружен. Этот плагин предназначен для работы с Polylang Automatic AI Translation."

#: pllat-date-filter.php
msgid "Settings are located in the \"Settings\" section instead of Polylang menu."
msgstr "Настройки находятся в разделе «Настройки», а не в меню Polylang."

#: pllat-date-filter.php
msgid "Please select at least one post status."
msgstr "Пожалуйста, выберите хотя бы один статус записи."

#: pllat-date-filter.php
msgid "Untranslated Posts Only"
msgstr "Только непереведённые записи"

#: pllat-date-filter.php
msgid "Only untranslated posts"
msgstr "Только непереведённые записи"

#: pllat-date-filter.php
msgid "If checked, only posts that have not been translated will be processed."
msgstr "Если отмечено, будут обрабатываться только записи, которые ещё не были переведены."

#: pllat-date-filter.php
msgid "Untranslated only:"
msgstr "Только непереведённые:"

#: pllat-date-filter.php
msgid "Yes"
msgstr "Да"

#: pllat-date-filter.php
msgid "No"
msgstr "Нет"

#: pllat-date-filter.php
msgid "Debug Mode"
msgstr "Режим отладки"

#: pllat-date-filter.php
msgid "Enable debug mode"
msgstr "Включить режим отладки"

#: pllat-date-filter.php
msgid "When enabled, detailed logs will be written to the WordPress debug log file."
msgstr "При включении подробные логи будут записываться в файл отладки WordPress."

#: pllat-date-filter.php
msgid "Debug mode:"
msgstr "Режим отладки:"

