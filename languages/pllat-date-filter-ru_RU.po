msgstr "Дважды в день"

#: pllat-date-filter.php
msgid "Daily"
msgstr "Ежедневно"

#: pllat-date-filter.php
msgid "Weekly"
msgstr "Еженедельно"

#: pllat-date-filter.php
msgid "How often to update the start date automatically"
msgstr "Как часто автоматически обновлять начальную дату"

#: pllat-date-filter.php
msgid "Update Method"
msgstr "Метод обновления"

#: pllat-date-filter.php
msgid "Set to today minus N days"
msgstr "Установить на сегодня минус N дней"

#: pllat-date-filter.php
msgid "Shift current date forward by N days"
msgstr "Сдвинуть текущую дату вперед на N дней"

#: pllat-date-filter.php
msgid "Method for calculating the new start date"
msgstr "Метод расчета новой начальной даты"

#: pllat-date-filter.php
msgid "Days to Shift"
msgstr "Количество дней для сдвига"

#: pllat-date-filter.php
msgid "Number of days to use for date calculation (1-365)"
msgstr "Количество дней для расчета даты (1-365)"

